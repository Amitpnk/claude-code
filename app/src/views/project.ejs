<%- include("partials/header", { title: project.name + " — TaskFlow" }) %>

<a class="back-link" href="/">&larr; All projects</a>

<div class="project-header">
  <div>
    <h1><%= project.name %></h1>
    <% if (project.description) { %>
      <p class="project-desc"><%= project.description %></p>
    <% } %>
  </div>
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <form method="post" action="/projects/<%= project.id %>/delete"
          onsubmit="return confirm('Delete this project and all its tasks?')">
      <button type="submit" class="delete-btn">Delete project</button>
    </form>
  <% } %>
</div>

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <form class="new-task-form" method="post" action="/projects/<%= project.id %>/tasks">
    <input type="text" name="title" placeholder="New task" required>
    <select name="priority">
      <option value="low">Low</option>
      <option value="medium" selected>Medium</option>
      <option value="high">High</option>
    </select>
    <button type="submit">Add task</button>
  </form>
<% } %>

<ul class="task-list">
  <% project.tasks.forEach(function(task) { %>
    <li class="task-item">
      <span class="task-badge task-badge--<%= task.status %>"><%= task.status.replace("_", " ") %></span>
      <span class="priority-badge priority-badge--<%= task.priority %>"><%= task.priority %></span>
      <span class="task-title"><%= task.title %></span>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <form method="post" action="/projects/<%= project.id %>/tasks/<%= task.id %>/delete"
              class="task-delete-form" onsubmit="return confirm('Delete this task?')">
          <button type="submit" class="task-delete-btn" aria-label="Delete task">&times;</button>
        </form>
      <% } %>
    </li>
  <% }); %>
</ul>

<%- include("partials/footer") %>
